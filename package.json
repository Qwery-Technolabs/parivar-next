{
  "name": "parivar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "node --max-old-space-size=1536 node_modules/next/dist/bin/next build",
    "start": "next start",
    "lint": "eslint",
    "db:schema": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/db-apply.mjs",
    "db:seed": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/db-seed.mjs",
    "db:dev": "node scripts/dev-db.mjs",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/db-migrate.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "mysql2": "^3.24.4",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "mysql-memory-server": "^1.16.0",
    "tailwindcss": "^4"
  },
  "type": "module"
}
