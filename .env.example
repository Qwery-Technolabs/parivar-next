DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=parivar
# Optional; defaults to 10 (3 on Vercel)
DB_POOL_SIZE=
# First super admin created by `npm run db:seed`
SEED_ADMIN_PHONE=9999999999
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_NAME=Super Admin
# Browser push: generate with  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Protects /api/cron/reminders (Vercel Cron sends it as a Bearer token)
CRON_SECRET=
